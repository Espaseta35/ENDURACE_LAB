{
  "name": "endurace-api",
  "main": "src/index.js",
  "compatibility_date": "2025-09-01",
  "routes": [{ "pattern": "api.endurace-lab.com", "custom_domain": true }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "endurace",
      "database_id": "REEMPLAZA_CON_EL_ID_QUE_TE_DE_WRANGLER",
      "migrations_dir": "migrations"
    }
  ],
  "send_email": [{ "name": "EMAIL" }],
  "triggers": { "crons": ["17 3 * * *"] },
  "vars": {
    "ALLOWED_ORIGINS": "https://www.endurace-lab.com,https://endurace-lab.com",
    "NOTIFY_TO": "info@endurace-lab.com",
    "MAIL_FROM": "web@endurace-lab.com",
    "RETENTION_DAYS": "365"
  }
}
